; In-game HUD. Instanced by main.tscn as the `HUD` CanvasLayer.
;
; Every child is an independent widget that drives itself from the Events bus.
; The anchors below are the 1280x720 defaults; HudRoot._relayout() restacks the
; right-hand column whenever the viewport changes size.

[gd_scene load_steps=12 format=3]

[ext_resource type="Script" path="res://ui/hud/hud.gd" id="1_hud"]
[ext_resource type="Script" path="res://ui/hud/status_bars.gd" id="2_bars"]
[ext_resource type="Script" path="res://ui/hud/minimap.gd" id="3_map"]
[ext_resource type="Script" path="res://ui/hud/plane_compass.gd" id="4_compass"]
[ext_resource type="Script" path="res://ui/hud/quest_tracker.gd" id="5_quest"]
[ext_resource type="Script" path="res://ui/hud/status_effects.gd" id="6_status"]
[ext_resource type="Script" path="res://ui/hud/hotbar.gd" id="7_hotbar"]
[ext_resource type="Script" path="res://ui/hud/crosshair.gd" id="8_cross"]
[ext_resource type="Script" path="res://ui/hud/damage_numbers.gd" id="9_dmg"]
[ext_resource type="Script" path="res://ui/hud/notifications.gd" id="10_notify"]
[ext_resource type="Script" path="res://ui/hud/debug_overlay.gd" id="11_debug"]

[node name="HUD" type="CanvasLayer"]
layer = 5
process_mode = 3
script = ExtResource("1_hud")

[node name="Root" type="Control" parent="."]
anchor_right = 1.0
anchor_bottom = 1.0
mouse_filter = 2

[node name="StatusBars" type="Control" parent="Root"]
anchor_right = 1.0
anchor_bottom = 1.0
mouse_filter = 2
script = ExtResource("2_bars")

[node name="Minimap" type="Control" parent="Root"]
anchor_left = 1.0
anchor_right = 1.0
offset_left = -210.0
offset_top = 270.0
offset_right = -14.0
offset_bottom = 470.0
grow_horizontal = 0
mouse_filter = 2
script = ExtResource("3_map")

[node name="PlaneCompass" type="Control" parent="Root"]
anchor_left = 1.0
anchor_right = 1.0
offset_left = -238.0
offset_top = 14.0
offset_right = -14.0
offset_bottom = 260.0
grow_horizontal = 0
mouse_filter = 2
script = ExtResource("4_compass")

[node name="QuestTracker" type="Control" parent="Root"]
