; Root gameplay scene. Every subsystem attaches here; the autoloads in
; project.godot supply the data layers (World, Blocks, Items, View, ...).
;
; Node contract — agents may extend these scripts but MUST keep the node names:
;   WorldRenderer  chunk meshes                (render/world_renderer.gd)
;   Entities       spawn parent for all actors (entities/entity_manager.gd)
;   Player         the paper-doll actor        (player/player.tscn)
;   CameraRig      orthographic plane camera   (camera/camera_rig.tscn)
;   FX             particles / shake / weather (fx/fx_root.tscn)
;   HUD, Menus     canvas layers               (ui/...)

[gd_scene load_steps=11 format=3]

[ext_resource type="Script" path="res://core/main.gd" id="1_main"]
[ext_resource type="Script" path="res://render/world_renderer.gd" id="2_render"]
[ext_resource type="Script" path="res://entities/entity_manager.gd" id="3_ents"]
[ext_resource type="PackedScene" path="res://player/player.tscn" id="4_player"]
[ext_resource type="PackedScene" path="res://camera/camera_rig.tscn" id="5_cam"]
[ext_resource type="PackedScene" path="res://fx/fx_root.tscn" id="6_fx"]
[ext_resource type="PackedScene" path="res://ui/hud/hud.tscn" id="7_hud"]
[ext_resource type="PackedScene" path="res://ui/menus/menu_root.tscn" id="8_menus"]

[sub_resource type="ProceduralSkyMaterial" id="Sky_1"]
sky_top_color = Color(0.18, 0.33, 0.62, 1)
sky_horizon_color = Color(0.55, 0.62, 0.72, 1)
ground_bottom_color = Color(0.06, 0.06, 0.09, 1)
ground_horizon_color = Color(0.35, 0.32, 0.3, 1)
sun_angle_max = 12.0

[sub_resource type="Sky" id="Sky_2"]
sky_material = SubResource("Sky_1")

[sub_resource type="Environment" id="Env_1"]
background_mode = 2
sky = SubResource("Sky_2")
ambient_light_source = 3
ambient_light_color = Color(0.6, 0.66, 0.78, 1)
ambient_light_sky_contribution = 0.6
ambient_light_energy = 0.7
tonemap_mode = 3
tonemap_white = 2.0
ssao_enabled = false
glow_enabled = true
glow_intensity = 0.35
glow_bloom = 0.05
fog_enabled = true
fog_light_color = Color(0.32, 0.4, 0.55, 1)
fog_density = 0.004
fog_sky_affect = 0.0

[node name="Main" type="Node3D"]
script = ExtResource("1_main")

[node name="WorldEnvironment" type="WorldEnvironment" parent="."]
environment = SubResource("Env_1")

[node name="SunLight" type="DirectionalLight3D" parent="."]
transform = Transform3D(0.866025, -0.353553, 0.353553, 0, 0.707107, 0.707107, -0.5, -0.612372, 0.612372, 0, 60, 0)
light_energy = 1.1
light_specular = 0.1
shadow_enabled = true
directional_shadow_mode = 1
directional_shadow_max_distance = 90.0

[node name="FillLight" type="DirectionalLight3D" parent="."]
transform = Transform3D(-0.866025, 0.25, -0.433013, 0, 0.866025, 0.5, 0.5, 0.433013, -0.75, 0, 40, 0)
light_color = Color(0.62, 0.7, 0.9, 1)
light_energy = 0.25
shadow_enabled = false

[node name="WorldRenderer" type="Node3D" parent="."]
script = ExtResource("2_render")

[node name="Entities" type="Node3D" parent="."]
script = ExtResource("3_ents")

[node name="Player" parent="." instance=ExtResource("4_player")]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 256.5, 120, 256.5)

[node name="CameraRig" parent="." instance=ExtResource("5_cam")]

[node name="FX" parent="." instance=ExtResource("6_fx")]

[node name="HUD" parent="." instance=ExtResource("7_hud")]

[node name="Menus" parent="." instance=ExtResource("8_menus")]
